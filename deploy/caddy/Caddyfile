# BOBRES gateway. Which certificates it serves is not decided here: the tls-agent
# writes /tls/global.caddy and /tls/sites.caddy (the install's tls/ directory), which
# this file imports, and makes Caddy load this file again. The three modes are an
# automatic certificate for the domain, a Let's Encrypt certificate for the server's
# IP address, and your own certificate; change them in the dashboard (System > HTTPS)
# or with `sudo bobres ssl`. For the domain (DNS A record pointing at this server,
# ports 80/443 open) Caddy issues the certificate itself.
{
	# The admin API listens on a unix socket in a volume that only this container and
	# the tls-agent mount, never on the network. 0220: write for root (Caddy) and for
	# group 65532 (the tls-agent), nobody else.
	admin unix//run/caddy/admin.sock|0220
	servers {
		protocols h1 h2 h3
		# Slow-client (slowloris) protection.
		timeouts {
			read_body   30s
			read_header 10s
			write       60s
			idle        2m
		}
	}
	# default_sni for an IP address, when one is served (comments only otherwise).
	import /tls/global.caddy
}

# What every BOBRES site serves. Each site block in /tls/sites.caddy (the domain, the
# server's IP address in ip mode, the Zarinpal domain) imports it and adds only its
# certificate setting.
#
# BOBRES_ZARINPAL_HOST (optional): a second domain registered with Zarinpal for the
# pay page and return URL, when the main domain is not reachable from Iran without a VPN.
(bobres_site) {
	encode zstd gzip

	header {
		# No includeSubDomains: the operator's domain may be an apex that also serves other,
		# plain-HTTP subdomains. Enable it deliberately once every subdomain is HTTPS.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# "?": only when the upstream sets none. The payments pay page sends
		# "origin", which Zarinpal needs to see where the payment started.
		?Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	log {
		output stdout
		format json
	}

	# On the Zarinpal domain only the pay page and the gateways' return URLs
	# (Zarinpal, IDPay, NextPay: the domain registered with each) exist: no
	# subscription links, admin or API on a domain registered with a payment
	# gateway. (The Zarinpal site in /tls/sites.caddy says so too, before this
	# snippet. When BOBRES_ZARINPAL_HOST is empty this compares with "", which no
	# request host equals, so it never matches.)
	@zarinpalHostOther {
		expression `{host} == "{$BOBRES_ZARINPAL_HOST}"`
		not path /pay/* /webhooks/zarinpal /webhooks/idpay /webhooks/nextpay
	}
	handle @zarinpalHostOther {
		respond "Not found" 404
	}

	# Service-to-service endpoints must never be reachable from the internet, even by mistake.
	@internal path /api/internal /api/internal/* /internal /internal/*
	handle @internal {
		respond "Not found" 404
	}

	# Payment pages a customer opens from the bot (Zarinpal must be started from a
	# page on the registered domain) and gateway returns/callbacks. The payments
	# service verifies every payment with the gateway; nothing here is trusted.
	@payments path /webhooks/* /pay/*
	handle @payments {
		request_body {
			max_size 1MB
		}
		reverse_proxy payments:8080 {
			health_uri /healthz
			health_interval 15s
			# Never trust a client-supplied forwarding chain.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Telegram webhook (only used when the bot runs in webhook mode; the bot checks the
	# secret token Telegram sends with every delivery).
	handle /tg/webhook {
		request_body {
			max_size 1MB
		}
		reverse_proxy bot:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Admin dashboard: strict CSP (scripts and fonts from self only), the same
	# policy core sends (web/dashboard/embed.go; a test keeps them equal). Core
	# sets caching: never for the page, a year for its content-hashed assets.
	handle /admin* {
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		header ?Cache-Control "no-store"
		request_body {
			max_size 10MB
		}
		reverse_proxy core:8080 {
			health_uri /healthz
			health_interval 15s
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Telegram Mini App store: the same strict CSP core sends (web/miniapp/embed.go;
	# a test keeps them equal), except that Telegram's script may load and
	# Telegram's web clients may frame the page, so the site-wide
	# X-Frame-Options is dropped here (frame-ancestors in the CSP replaces it).
	handle /app* {
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors https://*.telegram.org; base-uri 'none'; form-action 'self'"
		header ?Cache-Control "no-store"
		header -X-Frame-Options
		request_body {
			max_size 1MB
		}
		reverse_proxy core:8080 {
			health_uri /healthz
			health_interval 15s
			header_up X-Forwarded-For {remote_host}
		}
	}

	# JSON API and public subscription pages.
	@core path /api/* /sub/*
	handle @core {
		request_body {
			max_size 10MB
		}
		reverse_proxy core:8080 {
			health_uri /healthz
			health_interval 15s
			header_up X-Forwarded-For {remote_host}
		}
	}

	# External uptime probe. Reflects the REAL state: 200 only if core answers its own health check.
	handle /healthz {
		rewrite * /healthz
		reverse_proxy core:8080 {
			header_down -Server
		}
	}

	# Everything else does not exist.
	handle {
		respond "Not found" 404
	}
}

# One site block per served address, written by the tls-agent. A missing file stops
# Caddy (visible in bobres status) rather than serving nothing; bobres install writes
# a default for the first start, before the tls-agent has run.
import /tls/sites.caddy

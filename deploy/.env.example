# BOBRES environment. The installer generates this file with real random secrets
# (chmod 600). Never commit a real .env. Every CHANGE_ME must be replaced.
# Generate secrets URL-safe (hex or base64url): passwords are embedded in database URLs.

# --- general -----------------------------------------------------------------
BOBRES_ENV=prod
BOBRES_LOG_LEVEL=info
BOBRES_LOG_FORMAT=json
BOBRES_VERSION=latest
# Set by `bobres install` from the signed release CLI: "@sha256:<digest>" of each image of
# BOBRES_VERSION, so the store runs exactly the images that release built and signed, even
# if the tag is moved on the registry. Empty = the tag alone (a development build).
#BOBRES_IMAGE_DIGEST_CORE=@sha256:...
#BOBRES_IMAGE_DIGEST_BOT=@sha256:...
#BOBRES_IMAGE_DIGEST_PAYMENTS=@sha256:...
#BOBRES_IMAGE_DIGEST_PROVISIONER=@sha256:...
#BOBRES_IMAGE_DIGEST_BACKUP=@sha256:...
# Which releases the update check (dashboard, System > Updates) and `bobres update` follow:
# stable (default), or beta for pre-releases too (less tested). Going back to stable never
# downgrades: the install stays on its beta until a stable release is newer.
#BOBRES_UPDATE_CHANNEL=stable
# Public domain of this install (DNS A record must point to this server). A license is
# bound to it (docs/05-license.md): changing the domain needs a new license token.
BOBRES_DOMAIN=panel.example.com
# The vendor's license server, from the seller with the license key (https only; the bot
# does not start with anything else). `bobres license activate`, the dashboard's "Activate
# with a license key" and the daily renewal of an activated license use it: the bot makes
# the calls, because core has no internet access. Unset = online activation is off; a
# license token pasted or imported by hand still works. Apply a change with `bobres start`.
#BOBRES_LICENSE_SERVER=https://license.example.com

# --- database / cache (passwords must match the URLs below) -------------------
# POSTGRES_PASSWORD is the admin role and is only used by the database container itself.
# Every service connects with its OWN least-privilege role and schema (see postgres-init.sh).
POSTGRES_PASSWORD=CHANGE_ME_postgres_admin_password
DB_CORE_PASSWORD=CHANGE_ME_core_db_password
DB_PAYMENTS_PASSWORD=CHANGE_ME_payments_db_password
DB_PROVISIONER_PASSWORD=CHANGE_ME_provisioner_db_password
# The backup service's read-only role (svc_backup, pg_read_all_data): pg_dump only.
DB_BACKUP_PASSWORD=CHANGE_ME_backup_db_password
REDIS_PASSWORD=CHANGE_ME_redis_password
BOBRES_REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# --- internal service auth (32+ random chars each, all different) -------------
# Each service presents its own token; core accepts only the bot's. Core presents a
# different token to each service it calls, so no service holds a token another one
# accepts as core: payments accepts BOBRES_TOKEN_CORE, provisioner
# BOBRES_TOKEN_CORE_PROVISIONER, the bot BOBRES_TOKEN_CORE_BOT (receipt photos, test
# broadcasts and license calls) and the backup service BOBRES_TOKEN_CORE_BACKUP.
BOBRES_TOKEN_CORE=CHANGE_ME_core_service_token_32_chars_min
BOBRES_TOKEN_CORE_PROVISIONER=CHANGE_ME_core_to_provisioner_token_32_chars
BOBRES_TOKEN_CORE_BOT=CHANGE_ME_core_to_bot_token_32_chars_minimum
BOBRES_TOKEN_BOT=CHANGE_ME_bot_service_token_32_chars_minimum
# The backup service presents it to the bot, which sends each encrypted backup to
# BOBRES_ADMIN_TELEGRAM_ID only. Empty = backups stay on the server, unsent.
BOBRES_TOKEN_BACKUP=CHANGE_ME_backup_service_token_32_chars_min
# Core presents it to the backup service (list and start backups): a token for that one
# service, so the backup container, which holds the master keys, never holds a token
# another service accepts from core.
BOBRES_TOKEN_CORE_BACKUP=CHANGE_ME_core_to_backup_token_32_chars_min

# --- encryption at rest (32+ random chars each, back them up with the database) -
# provisioner: encrypts 3x-ui API tokens. core: encrypts dashboard 2FA secrets.
# payments: encrypts the Zarinpal merchant id and proxy saved in the dashboard (without
# it the Zarinpal values below are used as they are and cannot be changed there).
# Losing a key loses what it encrypts: re-enter the panel tokens or merchant id.
BOBRES_CORE_MASTER_KEY=CHANGE_ME_core_master_key_32_chars_minimum
BOBRES_PROVISIONER_MASTER_KEY=CHANGE_ME_provisioner_master_key_32_chars
BOBRES_PAYMENTS_MASTER_KEY=CHANGE_ME_payments_master_key_32_chars_min

# --- backups (the backup service; docs/06-installer.md) -------------------------
# Encrypts every backup (32+ chars). The installer shows it ONCE and in `bobres menu` >
# "Backup key". Store it away from this server: without it the backups cannot be read.
# Each backup also carries the three master keys above, so the file plus this key restores.
BOBRES_BACKUP_KEY=CHANGE_ME_backup_encryption_key_32_chars_min
# Daily run time, in BOBRES_TIMEZONE (HH:MM). The newest 7 backups are kept in ./backups.
BOBRES_BACKUP_TIME=03:30
# The backup service runs only with the "backup" Compose profile on. The installer sets
# both lines when the images have the service (any version from the one that added it).
COMPOSE_PROFILES=backup
BOBRES_BACKUP_URL=http://backup:8080
# Optional: a copy of each (still encrypted) backup in S3-compatible storage (Arvan, MinIO,
# Backblaze B2, AWS). Empty endpoint = no copy. A fresh `bobres install` asks for it, or
# --s3-endpoint, --s3-bucket, --s3-region, --s3-prefix (the two keys are asked, never flags).
# https only. An endpoint that is the bucket name on a service host of three or more labels
# (https://my-shop-backups.s3.example.com) is used as it is (virtual-hosted style); any
# other (https://s3.example.com) gets the bucket as the first path segment (path style).
# The region signs the requests (empty: us-east-1). The bucket keeps the newest
# BOBRES_BACKUP_S3_KEEP (default 30) bobres-<stamp>.bkp under the prefix; nothing else there
# is touched. `bobres restore s3://<bucket>/<prefix>/bobres-<stamp>.bkp` restores from it.
#BOBRES_BACKUP_S3_ENDPOINT=https://s3.example.com
#BOBRES_BACKUP_S3_BUCKET=my-shop-backups
#BOBRES_BACKUP_S3_REGION=us-east-1
#BOBRES_BACKUP_S3_PREFIX=bobres
#BOBRES_BACKUP_S3_ACCESS_KEY=
#BOBRES_BACKUP_S3_SECRET_KEY=
#BOBRES_BACKUP_S3_KEEP=30
# The backup service reaches the internet only for that copy: egress while the endpoint is
# set (the installer and `bobres config` keep it so); empty = an internal network of its own.
#BOBRES_BACKUP_NETWORK=egress

# --- telegram -----------------------------------------------------------------
BOBRES_TELEGRAM_BOT_TOKEN=CHANGE_ME_bot_token_from_botfather
# Becomes the owner (admin rights in the bot) on first /start.
BOBRES_ADMIN_TELEGRAM_ID=CHANGE_ME_numeric_telegram_id
# Time zone for dates shown in the bot (Persian dates use the Jalali calendar).
BOBRES_TIMEZONE=Asia/Tehran
# Optional webhook mode (default: long polling). The secret: 32+ chars of A-Z a-z 0-9 _ -
#BOBRES_TELEGRAM_WEBHOOK_URL=https://panel.example.com/tg/webhook
#BOBRES_TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_webhook_secret_32_chars_minimum

# --- Zarinpal (optional; only the payments service uses these) ----------------
# With BOBRES_PAYMENTS_MASTER_KEY set, the merchant id, proxy and sandbox below only seed
# the payment gateway settings on the first start; after that the dashboard (Payment
# gateways) is where they are changed, and later edits here are ignored. The public URL
# and BOBRES_ZARINPAL_HOST stay here (Caddy serves that domain).
# Off unless the merchant id is set. Zarinpal accepts API calls only from server IPs
# registered in its panel (at most 5): set BOBRES_ZARINPAL_PROXY to an http(s) proxy on a
# registered (Iranian) server if this server's IP cannot be registered. Payments must
# start from a page on the domain registered with Zarinpal, and buyers must reach it
# from Iran without a VPN: set BOBRES_ZARINPAL_PUBLIC_URL when that is not BOBRES_DOMAIN.
# The sandbox (BOBRES_ZARINPAL_SANDBOX=true) is refused when BOBRES_ENV=prod: any merchant id
# works there and the pay page needs no card. BOBRES_ZARINPAL_HOST is that second domain's
# host name (the installer derives it from the public URL) so Caddy serves it too.
#BOBRES_ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
#BOBRES_ZARINPAL_PROXY=http://user:password@203.0.113.10:3128
#BOBRES_ZARINPAL_PUBLIC_URL=https://pay.example.ir
#BOBRES_ZARINPAL_HOST=pay.example.ir

# --- 3x-ui panel (optional; only the provisioner uses these) ------------------
# The first panel, registered on the first start while no server exists. After that,
# servers are added and changed in the dashboard (Servers) and later edits here are
# ignored. Leave both empty to add every server in the dashboard.
BOBRES_XUI_URL=https://xui.example.com:2053
BOBRES_XUI_TOKEN=CHANGE_ME_3xui_api_token
# Public prefix of the panel's subscription server; the user's link is this + subId.
BOBRES_XUI_SUB_URL=https://xui.example.com:2096/sub/
# Set to true only if the panel is on this host or a private network. Then the URL may
# also be plain http, e.g. http://host.docker.internal:2053/path for a panel on this same
# server (it must listen on all interfaces, and the firewall must let Docker networks reach
# the port; 127.0.0.1 would be the container itself). Plain http to any address that is
# not private or loopback is refused. A panel with its own TLS certificate keeps its https URL.
BOBRES_XUI_ALLOW_PRIVATE=false

# BOBRES environment. The installer generates this file with real random secrets
# (chmod 600). Never commit a real .env. Every CHANGE_ME must be replaced.
# Generate secrets URL-safe (hex or base64url): passwords are embedded in database URLs.

# --- general -----------------------------------------------------------------
BOBRES_ENV=prod
BOBRES_LOG_LEVEL=info
BOBRES_LOG_FORMAT=json
BOBRES_VERSION=latest
# Public domain of this install (DNS A record must point to this server).
BOBRES_DOMAIN=panel.example.com

# --- database / cache (passwords must match the URLs below) -------------------
# POSTGRES_PASSWORD is the admin role and is only used by the database container itself.
# Every service connects with its OWN least-privilege role and schema (see postgres-init.sh).
POSTGRES_PASSWORD=CHANGE_ME_postgres_admin_password
DB_CORE_PASSWORD=CHANGE_ME_core_db_password
DB_PAYMENTS_PASSWORD=CHANGE_ME_payments_db_password
DB_PROVISIONER_PASSWORD=CHANGE_ME_provisioner_db_password
REDIS_PASSWORD=CHANGE_ME_redis_password
BOBRES_REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# --- internal service auth (32+ random chars each, all different) -------------
# Each service presents its own token; payments and provisioner accept only core's,
# core accepts only the bot's.
BOBRES_TOKEN_CORE=CHANGE_ME_core_service_token_32_chars_min
BOBRES_TOKEN_BOT=CHANGE_ME_bot_service_token_32_chars_minimum

# --- encryption at rest (32+ random chars each, back them up with the database) -
# provisioner: encrypts 3x-ui API tokens. core: encrypts dashboard 2FA secrets.
BOBRES_CORE_MASTER_KEY=CHANGE_ME_core_master_key_32_chars_minimum
BOBRES_PROVISIONER_MASTER_KEY=CHANGE_ME_provisioner_master_key_32_chars

# --- telegram -----------------------------------------------------------------
BOBRES_TELEGRAM_BOT_TOKEN=CHANGE_ME_bot_token_from_botfather
# Becomes the owner (admin rights in the bot) on first /start.
BOBRES_ADMIN_TELEGRAM_ID=CHANGE_ME_numeric_telegram_id
# Time zone for dates shown in the bot (Persian dates use the Jalali calendar).
BOBRES_TIMEZONE=Asia/Tehran
# Optional webhook mode (default: long polling). The secret: 32+ chars of A-Z a-z 0-9 _ -
#BOBRES_TELEGRAM_WEBHOOK_URL=https://panel.example.com/tg/webhook
#BOBRES_TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_webhook_secret_32_chars_minimum

# --- 3x-ui panel (only the provisioner uses these) ----------------------------
BOBRES_XUI_URL=https://xui.example.com:2053
BOBRES_XUI_TOKEN=CHANGE_ME_3xui_api_token
# Public prefix of the panel's subscription server; the user's link is this + subId.
BOBRES_XUI_SUB_URL=https://xui.example.com:2096/sub/
# Set to true only if the panel is on this host or a private network. Then the URL may
# also be plain http, e.g. http://host.docker.internal:2053/path for a panel on this same
# server (it must listen on all interfaces, and the firewall must let Docker networks reach
# the port; 127.0.0.1 would be the container itself). Plain http to any address that is
# not private or loopback is refused. A panel with its own TLS certificate keeps its https URL.
BOBRES_XUI_ALLOW_PRIVATE=false

# BOBRES gateway. TLS certificates are issued automatically for {$BOBRES_DOMAIN}
# (DNS A record must point at this server, ports 80/443 open).
{
	# Keep the admin endpoint off the network.
	admin off
	servers {
		protocols h1 h2 h3
		# Slow-client (slowloris) protection.
		timeouts {
			read_body   30s
			read_header 10s
			write       60s
			idle        2m
		}
	}
}

# BOBRES_ZARINPAL_HOST (optional): a second domain registered with Zarinpal for the
# pay page and return URL, when the main domain is not reachable from Iran without a VPN.
{$BOBRES_DOMAIN} {$BOBRES_ZARINPAL_HOST} {
	encode zstd gzip

	header {
		# No includeSubDomains: the operator's domain may be an apex that also serves other,
		# plain-HTTP subdomains. Enable it deliberately once every subdomain is HTTPS.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# "?": only when the upstream sets none. The payments pay page sends
		# "origin", which Zarinpal needs to see where the payment started.
		?Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	log {
		output stdout
		format json
	}

	# On the Zarinpal domain only the pay page and the return URL exist: no
	# subscription links, admin or API on a domain registered with a payment
	# gateway. (When BOBRES_ZARINPAL_HOST is empty this compares with "", which no
	# request host equals, so it never matches.)
	@zarinpalHostOther {
		expression `{host} == "{$BOBRES_ZARINPAL_HOST}"`
		not path /pay/* /webhooks/zarinpal
	}
	handle @zarinpalHostOther {
		respond "Not found" 404
	}

	# Service-to-service endpoints must never be reachable from the internet, even by mistake.
	@internal path /api/internal /api/internal/* /internal /internal/*
	handle @internal {
		respond "Not found" 404
	}

	# Payment pages a customer opens from the bot (Zarinpal must be started from a
	# page on the registered domain) and gateway returns/callbacks. The payments
	# service verifies every payment with the gateway; nothing here is trusted.
	@payments path /webhooks/* /pay/*
	handle @payments {
		request_body {
			max_size 1MB
		}
		reverse_proxy payments:8080 {
			health_uri /healthz
			health_interval 15s
			# Never trust a client-supplied forwarding chain.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Telegram webhook (only used when the bot runs in webhook mode; the bot checks the
	# secret token Telegram sends with every delivery).
	handle /tg/webhook {
		request_body {
			max_size 1MB
		}
		reverse_proxy bot:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Admin dashboard: strict CSP (scripts and fonts from self only), the same
	# policy core sends (web/dashboard/embed.go; a test keeps them equal). Core
	# sets caching: never for the page, a year for its content-hashed assets.
	handle /admin* {
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		header ?Cache-Control "no-store"
		request_body {
			max_size 10MB
		}
		reverse_proxy core:8080 {
			health_uri /healthz
			health_interval 15s
			header_up X-Forwarded-For {remote_host}
		}
	}

	# JSON API and public subscription pages.
	@core path /api/* /sub/*
	handle @core {
		request_body {
			max_size 10MB
		}
		reverse_proxy core:8080 {
			health_uri /healthz
			health_interval 15s
			header_up X-Forwarded-For {remote_host}
		}
	}

	# External uptime probe. Reflects the REAL state: 200 only if core answers its own health check.
	handle /healthz {
		rewrite * /healthz
		reverse_proxy core:8080 {
			header_down -Server
		}
	}

	# Everything else does not exist.
	handle {
		respond "Not found" 404
	}
}

# BOBRES vendor license server (deploy/vendor/docker-compose.yml). Copy to .env on the vendor's
# VPS, replace every CHANGE_ME, then `chmod 600 .env`. Never commit a real .env.
# The signing key is NOT here: only the PATH of its file is. The runbook is
# docs/runbooks/vendor-license-server.md.
# Generate passwords URL-safe (hex): the database one is embedded in a database URL, e.g.
#   openssl rand -hex 24

# --- public name ---------------------------------------------------------------
# The name installs use as BOBRES_LICENSE_SERVER=https://<this>. Its DNS A record must point
# at this server; Caddy gets the certificate by itself.
LICENSE_DOMAIN=license.example.com

# --- the signing key (a file, outside the repository) -----------------------------
# The private key made by `go run ./tools/license keygen`, copied to the server, owned by
# uid 65532, mode 0600, and mounted read-only into licensesrv. Never put the key itself here.
LICENSE_SIGNING_KEY_FILE=/etc/bobres-vendor/vendor-v1-2026.key

# --- database -----------------------------------------------------------------------
# POSTGRES_PASSWORD is the admin role, used only by the database container to create the
# license server's role. The server connects with its own role (DB_LICENSESRV_PASSWORD).
POSTGRES_PASSWORD=CHANGE_ME_postgres_admin_password
DB_LICENSESRV_PASSWORD=CHANGE_ME_licensesrv_db_password

# --- optional ---------------------------------------------------------------------
# What the image is called and labelled with (a tag from this repository, for example).
#BOBRES_VERSION=0.1.0
#BOBRES_LOG_LEVEL=info
# The internal network Caddy and licensesrv share. Change it only if 10.213.77.0/24 clashes
# with another network on this server. licensesrv believes X-Forwarded-* only from it.
#LICENSE_EDGE_SUBNET=10.213.77.0/24
# Rate limits (docs/13-license-server.md): per client address, and per license.
#BOBRES_LICENSESRV_RATE_IP=120/1h
#BOBRES_LICENSESRV_RATE_KEY=10/1h

# BOBRES vendor stack behind a Cloudflare Tunnel (deploy/vendor/tunnel/docker-compose.yml). Copy to .env on the
# server, replace every CHANGE_ME, then `chmod 600 .env`. Never commit a real .env. The two secrets are FILES
# (outside the repository, owned by uid 65532, mode 0600), never values here.
# Passwords URL-safe (hex): openssl rand -hex 24

# The license signing key (made by `go run ./tools/license keygen`): a file on the server.
LICENSE_SIGNING_KEY_FILE=/etc/bobres-vendor/vendor-v1-2026.key
# The tunnel's token (Cloudflare Zero Trust, Networks, Tunnels): a file on the server.
TUNNEL_TOKEN_FILE=/etc/bobres-vendor/tunnel-token

POSTGRES_PASSWORD=CHANGE_ME_postgres_admin_password
DB_LICENSESRV_PASSWORD=CHANGE_ME_licensesrv_db_password

# What the image is labelled with (a tag of this repository).
#BOBRES_VERSION=0.8.0
#BOBRES_LOG_LEVEL=info
# The internal network cloudflared, licensesrv and the site share. licensesrv believes X-Forwarded-* only from it.
#LICENSE_EDGE_SUBNET=10.213.77.0/24
#BOBRES_LICENSESRV_RATE_IP=120/1h
#BOBRES_LICENSESRV_RATE_KEY=10/1h
